{
  "route": {
    "default_domain_resolver": "dns-direct",
    "rule_set": [
      {
        "type": "local",
        "tag": [
          "block",
          "direct",
          "proxy",
          "custom-us"
        ],
        "format": "source",
        "path": "./rules/local/{tag}.json"
      },
      {
        "type": "remote",
        "tag": "Ads_AWAvenue",
        "format": "source",
        "url": "https://raw.githubusercontent.com/TG-Twilight/AWAvenue-Ads-Rule/main/Filters/AWAvenue-Ads-Rule-Singbox.json",
        "update_interval": "24h",
        "path": "./rules/remote/Ads_AWAvenue.json"
      },
      {
        "type": "remote",
        "tag": [
          "geosite/category-ads-all",
          "geosite/geolocation-!cn",
          "geosite/agilebits",
          "geosite/category-ai-!cn",
          "geosite/youtube",
          "geosite/google",
          "geosite/github",
          "geosite/telegram",
          "geoip/telegram",
          "geosite/tiktok",
          "geosite/netflix",
          "geoip/netflix",
          "geosite/disney",
          "geosite/spotify",
          "geosite/instagram",
          "geosite/steam@cn",
          "geosite/steam",
          "geosite/sony",
          "geosite/onedrive",
          "geosite/microsoft",
          "geosite/apple-cn",
          "geosite/apple",
          "geosite/paypal",
          "geosite/cn",
          "geoip/cn"
        ],
        "format": "binary",
        "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/{tag}.srs",
        "update_interval": "24h",
        "path": "./rules/remote/{tag}.srs"
      }
    ],
    "rules": [
      {
        "clash_mode": "Direct",
        "action": "route",
        "outbound": "direct"
      },
      {
        "action": "sniff"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "port": 53
          },
          {
            "protocol": "dns"
          }
        ],
        "action": "hijack-dns"
      },
      {
        "clash_mode": "Proxy",
        "action": "route",
        "outbound": "Proxy"
      },
      {
        "rule_set": "proxy",
        "action": "route",
        "outbound": "代理-自定义"
      },
      {
        "rule_set": "direct",
        "action": "route",
        "outbound": "直连-自定义"
      },
      {
        "rule_set": "custom-us",
        "action": "route",
        "outbound": "美国-自定义"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "clash_mode": "RuleAllowAds",
            "invert": true
          },
          {
            "rule_set": [
              "block",
              "Ads_AWAvenue",
              "geosite/category-ads-all"
            ]
          }
        ],
        "action": "reject"
      },
      {
        "rule_set": [
          "geosite/agilebits"
        ],
        "action": "route",
        "outbound": "1Password"
      },
      {
        "rule_set": [
          "geosite/category-ai-!cn"
        ],
        "action": "route",
        "outbound": "AI"
      },
      {
        "rule_set": [
          "geosite/youtube"
        ],
        "action": "route",
        "outbound": "Youtube"
      },
      {
        "rule_set": [
          "geosite/google"
        ],
        "action": "route",
        "outbound": "Google"
      },
      {
        "rule_set": [
          "geosite/github"
        ],
        "action": "route",
        "outbound": "Github"
      },
      {
        "rule_set": [
          "geosite/telegram"
        ],
        "action": "route",
        "outbound": "Telegram"
      },
      {
        "rule_set": [
          "geosite/tiktok"
        ],
        "action": "route",
        "outbound": "Tiktok"
      },
      {
        "rule_set": [
          "geosite/netflix",
          "geosite/disney",
          "geosite/spotify"
        ],
        "action": "route",
        "outbound": "Media"
      },
      {
        "rule_set": [
          "geosite/instagram"
        ],
        "action": "route",
        "outbound": "Instagram"
      },
      {
        "rule_set": [
          "geosite/steam@cn"
        ],
        "action": "route",
        "outbound": "Steam@CN"
      },
      {
        "rule_set": [
          "geosite/steam",
          "geosite/sony"
        ],
        "action": "route",
        "outbound": "Games"
      },
      {
        "rule_set": [
          "geosite/onedrive"
        ],
        "action": "route",
        "outbound": "Onedrive"
      },
      {
        "rule_set": [
          "geosite/microsoft"
        ],
        "action": "route",
        "outbound": "Microsoft"
      },
      {
        "rule_set": [
          "geosite/apple-cn"
        ],
        "action": "route",
        "outbound": "direct"
      },
      {
        "rule_set": [
          "geosite/apple"
        ],
        "action": "route",
        "outbound": "Apple"
      },
      {
        "rule_set": [
          "geosite/paypal"
        ],
        "action": "route",
        "outbound": "Paypal"
      },
      {
        "rule_set": [
          "geosite/cn"
        ],
        "action": "route",
        "outbound": "direct"
      },
      {
        "rule_set": [
          "geosite/geolocation-!cn"
        ],
        "action": "route",
        "outbound": "Proxy"
      },
      {
        "action": "resolve",
        "match_only": true
      },
      {
        "rule_set": "geoip/cn",
        "action": "route",
        "outbound": "direct"
      },
      {
        "rule_set": "geoip/telegram",
        "action": "route",
        "outbound": "Telegram"
      },
      {
        "rule_set": "geoip/netflix",
        "action": "route",
        "outbound": "Media"
      },
      {
        "ip_is_private": true,
        "outbound": "direct"
      },
      {
        "clash_mode": "Rule",
        "action": "route",
        "outbound": "Final"
      }
    ],
    "find_process": true,
    "auto_detect_interface": true,
    "final": "Final"
  }
}
