{
  "dns": {
    "servers": [
      {
        "tag": "dns-proxy",
        "type": "group",
        "servers": [
          "cloudflare",
          "google"
        ]
      },
      {
        "tag": "dns-direct",
        "type": "group",
        "servers": [
          "ali",
          "tencent"
        ]
      },
      {
        "type": "hosts",
        "tag": "hosts",
        "predefined": {
          "doh.pub": [
            "120.53.53.53",
            "1.12.12.12"
          ],
          "cloudflare-dns.com": [
            "1.1.1.1",
            "1.0.0.1"
          ],
          "dns.google": [
            "8.8.8.8",
            "8.8.4.4"
          ],
          "dns.alidns.com": [
            "223.5.5.5",
            "223.6.6.6"
          ]
        }
      },
      {
        "tag": "cloudflare",
        "type": "https",
        "server": "cloudflare-dns.com",
        "domain_resolver": "hosts",
        "detour": "Proxy"
      },
      {
        "tag": "google",
        "type": "https",
        "server": "dns.google",
        "domain_resolver": "hosts",
        "detour": "Proxy"
      },
      {
        "tag": "ali",
        "type": "https",
        "server": "dns.alidns.com",
        "domain_resolver": "hosts"
      },
      {
        "tag": "tencent",
        "type": "https",
        "server": "doh.pub",
        "domain_resolver": "hosts"
      }
    ],
    "rules": [
      {
        "clash_mode": "Proxy",
        "action": "route",
        "server": "dns-proxy"
      },
      {
        "clash_mode": "Direct",
        "action": "route",
        "server": "dns-direct"
      },
      {
        "action": "evaluate",
        "server": "dns-proxy"
      },
      {
        "match_response": true,
        "rule_set": [
          "direct",
          "geosite/apple-cn"
        ],
        "action": "route",
        "server": "dns-direct"
      },
      {
        "match_response": true,
        "rule_set": [
          "proxy",
          "custom-us"
        ],
        "action": "route",
        "server": "dns-proxy"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "clash_mode": "RuleAllowAds",
            "invert": true
          },
          {
            "match_response": true,
            "rule_set": [
              "block",
              "Ads_AWAvenue",
              "geosite/category-ads-all"
            ]
          }
        ],
        "action": "reject"
      },
      {
        "rule_set": [
          "geosite/category-ai-!cn",
          "geosite/google",
          "geosite/onedrive"
        ],
        "action": "route",
        "server": "dns-proxy"
      },
      {
        "rule_set": [
          "geosite/steam@cn",
          "geosite/apple",
          "geosite/microsoft"
        ],
        "action": "route",
        "server": "dns-direct"
      },
      {
        "rule_set": [
          "geosite/cn"
        ],
        "action": "route",
        "server": "dns-direct"
      },
      {
        "rule_set": [
          "geosite/geolocation-!cn"
        ],
        "action": "route",
        "server": "dns-proxy"
      }
    ],
    "final": "dns-proxy",
    "optimistic": true,
    "strategy": "ipv4_only"
  }
}
